  d_rod : CurtainRod { Center: {2.0, 2.92, 0.12} }
  d_curtain_l : CurtainMustard { Center: {1.2, 1.97, 0.12} }
  d_curtain_r : CurtainMustard { Center: {2.8, 1.97, 0.12}
