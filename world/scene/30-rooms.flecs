// Archive, no window: crates and a hanging bulb, now a dusty listening room. Amber neon "old".
prefab Basement : Room {
  (Uses, palette3)
  shelf : ShelfSurface {}
  desk  : DeskSurface {
    d_rp : RecordPlayer { Center: {1.7, 0, -0.25}
      Rests }
    d_radio : Radio { Center: {-1.7, 0, -0.2}
      Rests }
    d_mug : MugYellow { Center: {0.5, 0, 0.3}
      Rests }
  }
  crate_a : Wood { Center: {-2.2, 0.4, 2.4}
    Half: {0.4, 0.4, 0.4}
    Albedo: {0.45, 0.33, 0.2} }
  crate_b : Wood { Center: {-1.5, 0.3, 2.9}
    Half: {0.3, 0.3, 0.3}
    Albedo: {0.45, 0.33, 0.2} }
  crate_c : Wood { Center: {2.0, 0.45, 2.6}
    Half: {0.45, 0.45, 0.45}
    Albedo: {0.45, 0.33, 0.2} }
  bulb    : Bulb { Center: {0, 2.7, 1.4}
    Half: {0.1, 0, 0}
    LampColour: {3.5, 2.2, 1.0} }
  d_neon : SignOld { Center: {1.9, 2.2, 0.011} }
  d_strip : NeonAmber { Center: {-0.3, 0.955, 0.45}
    Half: {1.8, 0.008, 0.008} }
  d_bookcase : Bookcase { Center: {-2.85, 0.55, 0.012} }
  d_fridge : FridgeMint { Center: {-2.95, 0.42, 3.5} }
  d_armchair : ArmchairLeather { Center: {2.93, 0.22, 1.4} }
  d_rug : RugOchre { Center: {0, 0.02, 3.0}
    d_cat : Cat { Center: {0.9, 0, -0.2}
      Rests }
  }
  d_pendant : PendantRed { Center: {-0.8, 2.5, 1.6} }
  d_clock : Clock { Center: {-1.6, 2.5, 0.012} }
  d_art_a : WideDusk { Center: {-2.6, 1.95, 0.02} }
  d_art_b : WideSea { Center: {2.7, 1.9, 0.02} }
  d_lamp : FloorLampAmber { Center: {3.0, 1.62, 3.0} }
}
