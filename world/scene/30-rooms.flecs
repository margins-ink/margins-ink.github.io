// Floor templates. The exporter instantiates one of Lobby, Upper, Lower or Basement per floor
// (IsA) and parents each floor's magazines to it.

// Surfaces. Props are children of the surface they stand on and carry `Rests`: the exporter puts them on the
// parent's top face, so only x and z are given (relative to the surface centre) and nothing can sink or float.
prefab ShelfSurface : Wood {
  Center: {-0.3, 1.0, 0.27}
  Half: {2.0, 0.03, 0.27}
  Albedo: {0.4, 0.25, 0.13}
  Material: {0.3, 0}
}
prefab DeskSurface : Wood {
  Center: {0, 0.76, 1.3}
  Half: {2.6, 0.03, 0.85}
  Albedo: {0.35, 0.22, 0.12}
  Material: {0.2, 0}
}

// What every floor has: shell, title sign, desk legs and rug (the shelf and desk come with the room type).
prefab Room {
  shell : Shell { Center: {0, 1.6, 2.0}
    Half: {3.3, 1.6, 2.0} }
  sign  : Card  { Center: {0.2, 2.15, 0.03}
    Half: {0.75, 0.132, 0.012}
    Material: {0.28, 0}
    TexSign }
  leg_a : Solid { Center: {-2.5, 0.365, 0.55}
    Half: {0.04, 0.365, 0.04}
    Albedo: {0.18, 0.12, 0.08} }
  leg_b : Solid { Center: {-2.5, 0.365, 2.05}
    Half: {0.04, 0.365, 0.04}
    Albedo: {0.18, 0.12, 0.08} }
  leg_c : Solid { Center: {2.5, 0.365, 0.55}
    Half: {0.04, 0.365, 0.04}
    Albedo: {0.18, 0.12, 0.08} }
  leg_d : Solid { Center: {2.5, 0.365, 2.05}
    Half: {0.04, 0.365, 0.04}
    Albedo: {0.18, 0.12, 0.08} }
  rug   : Solid { Center: {0, 0.008, 3.0}
    Half: {2.4, 0.008, 0.9}
    Albedo: {0.35, 0.1, 0.08}
    Material: {1, 0} }
}

// The lived-in desk (tray, cup, notes). Each floor declares `desk : FurnishedDesk { ... }` and adds its own props
// as children of that instance (children of an inherited prefab child cannot be extended).
prefab FurnishedDesk : DeskSurface {
  tray  : Solid { Center: {-1.0, 0, -0.1}
    Half: {0.22, 0.012, 0.15}
    Albedo: {0.55, 0.55, 0.58}
    Material: {0.22, 1}
    Rests }
  cup   : Solid { Center: {-0.3, 0, 0.1}
    Half: {0.04, 0.05, 0.04}
    Albedo: {0.85, 0.85, 0.8}
    Material: {0.1, 0}
    Rests }
  notes : Solid { Center: {0.3, 0, 0.25}
    Half: {0.12, 0.17, 0.01}
    Albedo: {0.1, 0.12, 0.3}
    Flat: {theta: 0.3, per_floor: 1}
    Rests }
}

// A floor with daylight (the desk comes with each floor, see FurnishedDesk).
prefab Furnished : Room {
  window : Window { Center: {2.0, 1.95, 0.04} }
  shelf  : ShelfSurface {
    plant : Plant { Center: {1.75, 0, 0.03}
      Rests }
    lamp  : DeskLamp { Center: {-1.6, 0, 0.03}
      Rests }
  }
}

// ---- Decor (docs/DECOR.md). Names are d_*; every y that is written is a surface or floor-prop height from 12-decor.

// 2026: sunlit living room. Pink neon "hi!", mustard armchair, terracotta rug, black cat.
prefab Lobby : Furnished {
  (Uses, palette0)
  map_frame : Solid { Center: {-1.5, 2.4, 0.045}
    Half: {0.96, 0.69, 0.045}
    Albedo: {0.1, 0.06, 0.03} }
  map       : Card  { Center: {-1.5, 2.4, 0.095}
    Half: {0.9, 0.6328, 0.006}
    TexMap }
  desk : FurnishedDesk {
    d_rp : RecordPlayer { Center: {1.7, 0, -0.25}
      Rests }
    d_fig : FigurineTeal { Center: {0.95, 0, 0.3}
      Rests }
    d_cactus : Cactus { Center: {-1.9, 0, 0.2}
      Rests }
    d_mug : MugRed { Center: {-0.7, 0, 0.3}
      Rests }
  }
  d_neon : SignHi { Center: {0.45, 2.72, 0.011} }
  d_strip : NeonPink { Center: {-0.3, 0.955, 0.45}
    Half: {1.8, 0.008, 0.008} }
  d_rod : CurtainRod { Center: {2.0, 2.92, 0.12} }
  d_curtain_l : Curtain { Center: {1.2, 1.97, 0.12} }
  d_curtain_r : Curtain { Center: {2.8, 1.97, 0.12}
    (Pairs, d_curtain_l) }
  d_art_a : PosterSun { Center: {-0.1, 1.84, 0.02} }
  d_art_b : PosterSea { Center: {0.2, 1.84, 0.02} }
  d_art_c : PosterRose { Center: {0.5, 1.84, 0.02} }
  d_rug : RugTerracotta { Center: {0, 0.02, 3.0}
    d_cat : Cat { Center: {-1.0, 0, 0.25}
      Rests }
  }
  d_table : CoffeeTable { Center: {0.2, 0.4, 3.4}
    d_mug : MugYellow { Center: {-0.25, 0, 0.05}
      Rests }
    d_books : BookStack { Center: {0.2, 0, -0.05}
      Rests }
  }
  d_armchair : ArmchairMustard { Center: {2.93, 0.22, 1.4} }
  d_lamp : FloorLamp { Center: {-3.0, 1.62, 1.1} }
  d_pendant : PendantRed { Center: {-1.6, 2.5, 1.2} }
}

// 2024: night studio. Cyan neon "up", teal sofa and side table, violet curtains, beanbag, wall shelf of curios.
prefab Upper : Furnished {
  (Uses, palette1)
  desk : FurnishedDesk {
    d_rp : RecordPlayerWhite { Center: {1.7, 0, -0.25}
      Rests }
  }
  d_neon : SignUp { Center: {-1.6, 2.4, 0.011} }
  d_strip : NeonCyan { Center: {-0.3, 0.955, 0.45}
    Half: {1.8, 0.008, 0.008} }
  d_rod : CurtainRod { Center: {2.0, 2.92, 0.12} }
  d_curtain_l : CurtainViolet { Center: {1.2, 1.97, 0.12} }
  d_curtain_r : CurtainViolet { Center: {2.8, 1.97, 0.12}
    (Pairs, d_curtain_l) }
  d_clock : Clock { Center: {0.2, 2.75, 0.012} }
  d_wshelf : WallShelf { Center: {-2.75, 1.72, 0.1}
    d_books : BookStack { Center: {-0.25, 0, 0}
      Rests }
    d_fig : Figurine { Center: {0.05, 0, 0}
      Rests }
    d_cactus : CactusWhite { Center: {0.3, 0, 0}
      Rests }
  }
  d_rug : RugNavy { Center: {0, 0.02, 3.0}
    d_bean : Beanbag { Center: {1.1, 0, 0.1}
      Rests }
  }
  d_sofa : SofaTeal { Center: {-0.9, 0.22, 2.75} }
  d_table : CoffeeTable { Center: {-0.9, 0.4, 3.5}
    d_mug : MugBlue { Center: {-0.2, 0, 0.05}
      Rests }
    d_books : BookStack { Center: {0.2, 0, -0.05}
      Rests }
  }
  d_side : SideTable { Center: {-2.2, 0.5, 2.75}
    (Near, d_sofa)
    d_tlamp : TableLamp { Center: {0, 0, 0}
      Rests }
  }
  d_pendant : PendantBlack { Center: {1.0, 2.5, 1.5} }
}

