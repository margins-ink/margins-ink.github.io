// Floor templates. The exporter instantiates one of Lobby, Upper, Lower or Basement per floor
// (IsA) and parents each floor's magazines to it.

// What every floor has: shell, shelf, title sign, desk with rug.
prefab Room {
  shell : Shell { Center: {0, 1.6, 2.0}
    Half: {3.3, 1.6, 2.0} }
  shelf : Wood  { Center: {-0.3, 1.0, 0.27}
    Half: {2.0, 0.03, 0.27}
    Albedo: {0.4, 0.25, 0.13} }
  sign  : Card  { Center: {0.2, 2.15, 0.03}
    Half: {0.75, 0.132, 0.012}
    TexSign }
  desk  : Wood  { Center: {0, 0.76, 1.3}
    Half: {2.6, 0.03, 0.85}
    Albedo: {0.35, 0.22, 0.12} }
  leg_a : Solid { Center: {-2.5, 0.365, 0.55}
    Half: {0.04, 0.365, 0.04}
    Albedo: {0.18, 0.12, 0.08} }
  leg_b : Solid { Center: {-2.5, 0.365, 2.05}
    Half: {0.04, 0.365, 0.04}
    Albedo: {0.18, 0.12, 0.08} }
  leg_c : Solid { Center: {2.5, 0.365, 0.55}
    Half: {0.04, 0.365, 0.04}
    Albedo: {0.18, 0.12, 0.08} }
  leg_d : Solid { Center: {2.5, 0.365, 2.05}
    Half: {0.04, 0.365, 0.04}
    Albedo: {0.18, 0.12, 0.08} }
  rug   : Solid { Center: {0, 0.008, 3.0}
    Half: {2.4, 0.008, 0.9}
    Albedo: {0.35, 0.1, 0.08} }
}

// A floor with daylight and a lived-in desk.
prefab Furnished : Room {
  window : Window { Center: {2.0, 1.95, 0.04} }
  tray   : Solid { Center: {-1.0, 0.802, 1.2}
    Half: {0.22, 0.012, 0.15}
    Albedo: {0.55, 0.55, 0.58} }
  cup    : Solid { Center: {-0.3, 0.84, 1.4}
    Half: {0.04, 0.05, 0.04}
    Albedo: {0.85, 0.85, 0.8} }
  notes  : Solid { Center: {0.3, 0.8, 1.55}
    Half: {0.12, 0.01, 0.17}
    Albedo: {0.1, 0.12, 0.3}
    Flat: {theta: 0.3, per_floor: 1} }
  plant  : Plant { Center: {1.45, 1.1, 0.3} }
  lamp   : DeskLamp { Center: {-1.9, 1.07, 0.3} }
}

prefab Lobby : Furnished {
  (Uses, palette0)
  map_frame : Solid { Center: {-1.5, 2.4, 0.045}
    Half: {0.96, 0.69, 0.045}
    Albedo: {0.1, 0.06, 0.03} }
  map       : Card  { Center: {-1.5, 2.4, 0.095}
    Half: {0.9, 0.6328, 0.006}
    TexMap }
}
prefab Upper : Furnished { (Uses, palette1) }
prefab Lower : Furnished { (Uses, palette2) }

// No window: crates and a hanging bulb.
prefab Basement : Room {
  (Uses, palette3)
  crate_a : Wood { Center: {-2.2, 0.4, 2.4}
    Half: {0.4, 0.4, 0.4}
    Albedo: {0.45, 0.33, 0.2} }
  crate_b : Wood { Center: {-1.5, 0.3, 2.9}
    Half: {0.3, 0.3, 0.3}
    Albedo: {0.45, 0.33, 0.2} }
  crate_c : Wood { Center: {2.0, 0.45, 2.6}
    Half: {0.45, 0.45, 0.45}
    Albedo: {0.45, 0.33, 0.2} }
  bulb    : Bulb { Center: {0, 2.7, 1.4}
    Half: {0.1, 0, 0}
    LampColour: {3.5, 2.2, 1.0} }
}
