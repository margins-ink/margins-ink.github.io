// Desk lamp: dark base with a warm bulb above it. The bulb is the level's lamp.
prefab DeskLamp : Solid {
  Albedo: {0.15, 0.15, 0.15}
  Material: {0.3, 0.9}
  Half: {0.05, 0.04, 0.05}
  bulb : Bulb { Center: {0, 0.13, 0}
    Half: {0.07, 0, 0}
    LampColour: {4, 2.4, 1.1} }
}

prefab Magazine : Card {
  Half: {0.21, 0.29, 0.006}
  Lean: {angle: 0.13962634}
  // The hover affordance (world/src/hover.rs), read every frame, so saving this file retunes it live.
  // lift_y / lift_z: metres up and out of the shelf. tilt_deg: the top edge comes toward the viewer (pivots on the bottom edge).
  // crack_deg: the cover opens about the spine (8 to 12 reads as "can be opened"). omega (rad/s) and zeta: the spring of the lift and
  // tilt (zeta < 1 overshoots a little); crack_omega / crack_zeta: the cover's own spring. rim: HDR intensity of the amber edge glow.
  // nudge_s / nudge_amount: the touch-device invitation (one slow open and close, a share of the full hover).
  // Spacing: neighbours are 0.62 m apart for a 0.42 m cover; the crack moves the free edge 0.42 sin(crack) toward the viewer only.
  HoverTune: {lift_y: 0.02, lift_z: 0.03, tilt_deg: 4, crack_deg: 10, omega: 14, zeta: 0.62, crack_omega: 11, crack_zeta: 0.7, rim: 1.4, nudge_s: 2.6, nudge_amount: 0.8}
  // The page block behind the cover: hidden at rest, it shows as a cream edge when the cover cracks. Same lean as the magazine;
  // its centre sits 0.0115 behind the cover along the lean axis (0.0115 * sin 8 deg, cos 8 deg).
  pages : Solid {
    BookPages
    Center: {0, -0.0016, -0.0114}
    Half: {0.2, 0.28, 0.005}
    Lean: {angle: 0.13962634}
    Albedo: {0.88, 0.85, 0.76}
    Material: {0.9, 0}
  }
}
