// Object prefabs. Kind selects the shader's treatment (see docs/WORLD.md):
// 0 plain box, 1 glass pane (sky light), 2 textured card (atlas rect in Tex), 4 room shell,
// 6 wood-grain box, 8 sphere (foliage), 9 emissive sphere (lamp).
// Positions are local to the parent entity when the parent has a Center, otherwise local to the floor.
// Material: {roughness, metallic}. On a Shell the roughness is the floor's (walls and ceiling are matte in the shader).
prefab Object {
  Albedo: {0.5, 0.5, 0.5}
  Tex: {0, 0, 1, 1}
  Material: {0.8, 0}
}
prefab Solid : Object { Kind: {0}
  Material: {0.55, 0} }
prefab Glass : Object { Kind: {1} }
prefab Card  : Object { Kind: {2}
  Material: {0.5, 0} }
prefab Shell : Object { Kind: {4}
  Material: {0.3, 0} }
prefab Wood  : Object { Kind: {6}
  Material: {0.3, 0} }
prefab Leaf  : Object { Kind: {8}
  Material: {0.5, 0} }
prefab Bulb  : Object { Kind: {9} }

// Four-pane window; the panes are the level's sky lights.
prefab Window : Solid {
  Albedo: {0.82, 0.8, 0.74}
  Half: {0.62, 0.82, 0.03}
  pane_tl : Glass { Center: {-0.3, 0.4, 0.04}
    Half: {0.27, 0.37, 0.01} }
  pane_tr : Glass { Center: {0.3, 0.4, 0.04}
    Half: {0.27, 0.37, 0.01} }
  pane_bl : Glass { Center: {-0.3, -0.4, 0.04}
    Half: {0.27, 0.37, 0.01} }
  pane_br : Glass { Center: {0.3, -0.4, 0.04}
    Half: {0.27, 0.37, 0.01} }
}

