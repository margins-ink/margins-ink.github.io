    DemoPause: {
      chapter: "9  A codebase of hashes",
      ex: "models/merkle",
      preset: 0,
      prompt: "Your turn: edit config, then util, then rename a name",
      note: "toy hashes: four digits of FNV-1a, mine, not Unison's",
      hold: 20,
      l1: "Here's a toy codebase. The hashes are mine, not Unison's.",
      l2: "Edit config, and parse stays reused. Edit util, and everything built on it changes. Now switch to rename, and click a name.",
      l3: "[pause] Nothing moves. *Nothing recompiles.*",
      l4: "The docs say it plainly. Once anyone has typechecked a definition and added it to the codebase, no one has to do that ever again. A pure test whose dependencies haven't changed doesn't rerun. And code moves to the data: the sender ships a bytecode tree, and only the hashes the other side is missing cross the wire.",
      g1: 0.6,
      g3: 20.4,
      g4: 0.6
    }
