  // ---- 10. Effects, and where the picture breaks (7:50 to 8:15) ----
  effects : Scene {
    Heading: {"Effects, and where the picture breaks"}
    Covers: {"effects in the type, and the edges: cost and same behaviour"}
    Still: {10}
    EdgeCases: {
      chapter: "10  Where the picture breaks",
      ty: "Nat -> Nat ->\{Exception} Nat",
      effect: "effect: \{Exception}",
      caseA: "Cost",
      demoA: "Church and Turing say nothing about it",
      caseB: "Same behaviour?",
      demoB: "x + 1  #a3f9\n1 + x  #07c2\n(toy hashes)",
      l1: "Effects get the same treatment. In Unison, the type carries the effect, and the body reads like the tape. The docs say direct-style effects and monads have the same expressive power.",
      l2: "The picture has edges. Church and Turing say nothing about cost. Whether a beta step is a fair unit of time stayed open until two thousand sixteen. And a hash only says two trees match. X plus one and one plus x hash differently."
    }
  }

  // ---- 11. The reveal and the close (8:15 to 8:40) ----
  reveal : Scene {
    Heading: {"The reveal and the close"}
    Covers: {"each border is a decision about when a computation runs and who keeps the result; write the signature by hand"}
    Still: {10}
    RevealScene: {
      chapter: "11  When it runs",
      ex: "models/two-machines",
      big: "When does it run?",
      sub: "compile time, run time, read time, once long ago",
      card: "",
      cw: 0,
      l1: "Functional against imperative. Program against type. Inferred against written. They look like borders between kinds of thing. Each one is a decision about when a computation runs, and who keeps the result."
    }
    ph4 : Hatch {
      Pos: {16, 17}
      Size: {20, 1.2}
      Placeholder
    }
    ph4t : Mark {
      Words: {"PLACEHOLDER: exhibit 4, the \"when does it run\" timeline strip (not built)"}
      Pos: {16, 17.3}
      Align: {"centre"}
      Em: {0.3}
      Ink: {"ink3"}
      Layer: {2}
    }
    wall_end : Rail {
      Pos: {16, 11.8}
      Size: {0, 4.2}
      Ink: {"accent"}
      Stroke: {0.28}
      Layer: {4}
    }
    sb1 : Beat {
      Fade: {0.6}
      (On, rv_sub)
      (Pin, rv_1)
      Word: {26, 0}
    }
    wb1 : Beat {
      Hide
      Fade: {2}
      (On, wall_end)
      (Pin, rv_1)
      Word: {20, 0}
    }
    Outro: {
      code: "def Tuple : Nat → Type\n  | 0 => Unit\n  | n + 1 => Nat × Tuple n\n\n\n  | 0 => ()\n  | n + 1 => (n, mkTuple n)",
      sig: "def mkTuple : (n : Nat) → Tuple n",
      err: "error: Type mismatch\n  (n, mkTuple n)\nhas type\n  Nat × Unit\nbut is expected to have type\n  Unit",
      l1: "A type is a computation scheduled before the program runs. A signature is one you scheduled by hand.",
      l2: "Write it where no machine can schedule it for you.",
      g1: 0.8,
      g2: 0.6
    }
    // the exhibit and the big line leave when the editor returns
    ox1 : Beat {
      Hide
      Fade: {0.5}
      (On, rv_ex)
      (Pin, ou_1)
      Word: {0, -0.6}
    }
    ox2 : Beat {
