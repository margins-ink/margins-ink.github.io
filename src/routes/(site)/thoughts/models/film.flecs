    }
    pa_1 : CaptionLine {
      Text: {"Even where inference works, someone pays. Write main equals print hi, and Lean works out IO Unit. That type lives in your editor's hover. It never lives in the text, so every reader derives it again. A written signature is that work, stored once."}
    }
    pa_2 : CaptionLine {
      Text: {"So what if the work could be stored for everyone, forever? Unison stores something else. A definition is identified by a hash of its syntax tree. Names are just separate metadata that don't change the hash."}
      Gap: {0.6}
    }
    pa_b1 : Beat {
      Fade: {0.4}
      (On, pa_tip)
      (Pin, pa_1)
      Word: {11, 0}
