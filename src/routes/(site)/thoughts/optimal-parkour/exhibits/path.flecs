// A grid search (docs/MUSEUM.md, GridMachine): Dijkstra and A* on a Board. `#` wall, `.` open, S start, G goal, rows split by `/`.
// Click a cell to toggle a wall; the A* control switches the algorithm. Each step expands one cell; unit cost, no diagonals.
open : Preset {
  Title: {"open field"}
  Board: {"................../................../................../................../..S............G../................../................../................../.................."}
}
gap : Preset {
  Title: {"wall with a gap"}
  Board: {".........#......../.........#......../.........#......../.........#......../..S......#.....G../.........#......../.........#......../................../.................."}
}
cup : Preset {
  Title: {"cup around the goal"}
  Board: {"................../................../..........######../..........#......./..S.......#..G..../..........#......./..........######../................../.................."}
}

path : GridMachine {
  Title: {"Dijkstra and A* on a grid"}
  Claim: {"A* expands fewer blocks than Dijkstra because its guess points at the goal."}
  Describe: {"A grid of blocks with a start and a goal. Each step expands one block: the search takes the open block with the lowest cost so far plus its guess of the distance left, marks it closed and opens its neighbours. Dijkstra uses no guess and A* uses the number of blocks left to cross if there were no walls. Clicking a block toggles a wall and restarts the search."}
  Alt: {"A grid of blocks with S on the left and G on the right. Closed blocks are tinted, the open frontier is a dimmer tint, walls are dark, and when the goal is reached the path from S to G is drawn in the accent colour."}
  Caption: {"Click a block to toggle a wall. Switch to A* and run the same board."}
  (Runs, open)

  b_step : Button {
    Place: {1, 1.2, 4, 1.8}
    Label: {"Step"}
    Does: {"step"}
    Key: {"s"}
  }
  b_run : Button {
    Place: {5.4, 1.2, 4, 1.8}
    Label: {"Run"}
    LabelAlt: {"Pause"}
    Does: {"run"}
    Key: {" "}
  }
  b_reset : Button {
    Place: {9.8, 1.2, 4, 1.8}
    Label: {"Reset"}
    Does: {"reset"}
    Key: {"r"}
  }
  speed : Slider {
    Place: {15, 1.2, 6, 1.8}
    Label: {"speed"}
    Does: {"scrub"}
    Binds: {"Rate.hz"}
    Range: {2, 60}
  }
  b_astar : Button {
    Place: {22.4, 1.2, 4.6, 1.8}
    Label: {"A*"}
    Does: {"toggle"}
    Key: {"a"}
  }
  b_open : Button {
    Place: {1, 3.4, 6.4, 1.8}
    Label: {"open field"}
    Does: {"load"}
    Loads: {"open"}
  }
  b_gap : Button {
    Place: {7.8, 3.4, 8, 1.8}
    Label: {"wall with gap"}
    Does: {"load"}
    Loads: {"gap"}
  }
  b_cup : Button {
    Place: {16.2, 3.4, 6.4, 1.8}
    Label: {"cup"}
    Does: {"load"}
    Loads: {"cup"}
  }
  status : StatusLine {
    Place: {1, 5.7, 34, 1.2}
  }
  view : View {
    Place: {1, 7.2, 34, 12.3}
  }
}
