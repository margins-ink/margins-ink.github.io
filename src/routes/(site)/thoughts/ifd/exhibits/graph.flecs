graph : GraphMachine {
  Title: {"An action graph with a cache"}
  Claim: {"A changed input changes the key of every action downstream and nothing else."}
  Describe: {"The six-unit workspace as a graph: six source files on the left and six actions that read them and each other. Clicking a source file edits it, which changes the key of every action that reads it, directly or through another action. Each step looks the next action's key up in the cache and reports a hit or a rebuild."}
  Alt: {"A graph of six source files and six build actions joined by arrows, each showing a four digit key. After an edit, the changed actions show their old and new keys and a rebuilt mark, and the others show cache hit."}
  Caption: {"Click a source file to edit it, then step through the actions. Click it again to put it back."}
  OnHit: {"cache hit"}
  OnBuilt: {"rebuilt"}
  Extent: {36, 20.4}
  Content: {"Click a file to edit it"}
  (Runs, workspace)

  b_run : Button {
    Place: {29.95, 0.85, 1.8, 1.8}
    Label: {"Run"}
    LabelAlt: {"Pause"}
    Icon: {"play/pause"}
    Does: {"run"}
    Key: {" "}
  }
  b_step : Button {
    Place: {31.9, 1.0, 1.5, 1.5}
    Label: {"Step"}
    Icon: {"step"}
    Does: {"step"}
    Key: {"s"}
  }
  b_reset : Button {
    Place: {33.5, 1.0, 1.5, 1.5}
    Label: {"Reset"}
    Icon: {"reset"}
    Does: {"reset"}
    Key: {"r"}
  }
  view : View {
    Place: {0.5, 3.4, 35, 16.2}
  }
}
